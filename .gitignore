.pio
env/
pcb/**/Gaggimate-backups
pcb/**/*.kicad_sch_old
.vscode
.idea
node_modules/
__pycache__
data/w
.codebuddy
*.orig
src/version.h
src/display/ui/default/lvgl/project.info
# Generated web UI bundle embedded into firmware flash (scripts/embed_webui.py)
src/display/webassets/
# Desktop simulator runtime data (settings/profiles/shots) and screenshots
sim_data/
*.bmp

# pioarduino build artifacts (regenerated each build). The generated sdkconfig
# for every env is ignored by pattern, so adding an env does not leak an
# untracked file; the hand-written sdkconfig.*.defaults inputs stay tracked.
sdkconfig
sdkconfig.*
!sdkconfig.*.defaults
managed_components/
# Generated by scripts/pioarduino_env.py when the installed pioarduino package
# carries a hashed directory name. Must stay untracked: a project-local
# components/ entry outranks EXTRA_COMPONENT_DIRS, so a committed copy would
# shadow the real Arduino framework wherever the package name does not collide.
/components/framework-arduinoespressif32/
# pioarduino dual-framework hybrid-compile scaffold (auto-generated)
.dummy/

# Serial/device monitor captures
logs/

# Editor / agent workspaces
.serena/
.claude/
