# Display-env sdkconfig overrides (layered on top of sdkconfig.common.defaults).
# Routes NimBLE host + WiFi/LWIP + BSS to PSRAM and keeps 16 KB internal
# reserved for DMA-bound callers. Avoids BLE_INIT malloc storms under the
# combined pressure of WiFi AP + HomeSpan + BLE GATT links on ESP32-S3.

# --- Flash size ---
# PlatformIO does NOT push board.json's flash size into the IDF build. All it
# does is compare the two after the fact and print a warning:
# builder/frameworks/espidf.py compares board upload.flash_size against
# CONFIG_ESPTOOLPY_FLASHSIZE and emits "Warning! Flash memory size mismatch
# detected." Nothing changes the config. Left unset, Kconfig's own default of
# 2 MB wins, the IDF-built bootloader records 2 MB in the image header, and IDF
# clamps usable flash to that -- which puts most of a default_16mb.csv layout
# (both OTA slots and the LittleFS partition) outside the addressable window.
#
# So it has to be pinned here, and this file is the display-class one: the
# LilyGo T-RGB is 16 MB. The 8 MB display-headless-8m board (seeed xiao) layers
# sdkconfig.flash8m.defaults after this file to override it, and the controller
# pins 8 MB in sdkconfig.controller.defaults. scripts/assert_sdkconfig.py checks
# the merged value against the board's declared size at link time so a new env
# cannot silently inherit the wrong one.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- PSRAM (octal 80MHz) — display-class boards only ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Threshold below which allocations are forced into internal DRAM. arduino-esp32
# baseline is 4096; we had dropped it to 512, which pushed mid-size (512-4096 B)
# allocations to PSRAM and left internal DRAM shattered into tiny blocks —
# startup fragmentation (1 - largest_free/total_free) ballooned 15% -> 64%,
# starving contiguous internal allocs AsyncTCP needs to serve. Restore 4096.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384

# --- MSPI cache geometry ---
#
# Flash and PSRAM share one controller and one cache on the ESP32-S3, and the
# LCD scan-out has to win a race against everything else on that bus every
# frame. The cache line size sets how many bytes each miss fetches, so it is
# the direct lever on how many separate PSRAM transactions the same byte count
# costs. The framebuffer is streamed, not randomly poked: the render task
# writes it front to back and the bounce-buffer refill reads it front to back,
# which is the access pattern a long line serves best. At 32 bytes a 9600-byte
# bounce refill is 300 transactions; at 64 it is 150, each one amortising the
# octal-PSRAM command and latency overhead over twice as much payload.
#
# This costs no RAM: the cache is already allocated, only its line granularity
# changes. There is no matching knob for instructions -- the S3's instruction
# cache tops out at a 32-byte line.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Not enabling CONFIG_SPIRAM_XIP_FROM_PSRAM (and so not
# SPIRAM_FETCH_INSTRUCTIONS / SPIRAM_RODATA), even though Espressif's LCD FAQ
# lists them among the prerequisites for RGB bounce-buffer mode. Their argument
# is sound on both counts: flash and PSRAM share the MSPI controller and octal
# PSRAM is four times the bandwidth of quad SDR flash, so an instruction miss
# served from PSRAM occupies the controller for a quarter as long; and a flash
# write disables the cache, which suspends the bounce-buffer refill ISR
# (esp_lcd_panel_rgb.c warns its memcpy would crash, not merely glitch, if it
# ran then), so every NVS save is a run of stale bounce buffers on screen.
#
# It does not survive contact with this firmware's size. Measured: copying .text
# and .rodata into PSRAM at startup took 4.3 MB of the 4.5 MB free, leaving
# 255 kB. Internal DRAM gained 19.5 kB, since code that needed IRAM placement no
# longer does, but the background animations could not allocate their working
# buffers at all and the screen came up as bare text on black. The embedded web
# UI blob and the LVGL fonts are most of that 4.3 MB.
#
# So the brief corruption during an NVS write stands as a known defect. It is
# bounded by the write and it is what upstream ships.

# Route NimBLE host + mbedTLS allocations to PSRAM (reclaims ~40 KB internal).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 4 connections: display acts as central for BLE scales + peripheral for HomeKit.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# Bump host task stack from 4096: continuous scale scanning drives the NimBLE
# host callback context hot. 4 KB runs close to the high-water mark during
# scan-complete bursts.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# HKDF used by HomeSpan for HomeKit pairing key derivation.
CONFIG_MBEDTLS_HKDF_C=y

# --- LWIP (socket tuning borrowed from ESPHome PR #10647) ---
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y

# --- IPv6 ---
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# --- Nano newlib ---
# Disabled: HomeSpan 2.1.7 uses GNU %m scanf in Span::configureNetwork() —
# nano-newlib drops it, leaving `d` uninitialised and crashing on strlen(d).
# Full newlib costs ~15-25 KB flash.
# NOTE: IDF 5.5 renamed NEWLIB_NANO_FORMAT → LIBC_NEWLIB_NANO_FORMAT.
CONFIG_LIBC_NEWLIB_NANO_FORMAT=n

# --- C++ exceptions ---
# esp-arduino-ble-scales' RemoteScales uses try/catch (e.g. the noexcept dtor
# wraps clientCleanup()). IDF defaults to -fno-exceptions; arduino-esp32 built
# with exceptions on, so the display class enables them here. Controller env
# does not link the scales lib and stays -fno-exceptions.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# --- RGB LCD: restart GDMA at every VBlank ---
# Off, which is also the IDF default. It was on as a workaround for the
# scan-out desync that GM_LCD_BOUNCE_LINES now fixes at the source, and in
# bounce mode it does active harm.
#
# Read lcd_rgb_panel_try_restart_transmission() in
# components/esp_lcd/rgb/esp_lcd_panel_rgb.c. With this set, do_restart is
# true unconditionally, so the LCD FIFO and the GDMA channel are reset on
# every VSYNC. Without bounce buffers that restarts the stream from the
# framebuffer head, which is where the old comment here got its claim. With
# bounce buffers it restarts from bounce_buffer[0], filled from whatever
# bounce_pos_px the refill ISR had reached, and that pointer is only forced
# back to 0 when it exceeds two buffers. So each frame begins scanning at a
# near-arbitrary multiple of the bounce buffer and the picture jumps
# vertically in 5-line steps, frame after frame. Observed on hardware as a
# pronounced vertical shake.
#
# It also compiles out the genuine underrun detector, which lives only in
# the #else branch: bb_eof_count < expect_eof_count at VSYNC means the
# refill ISR fell behind during the frame, and that is what should trigger a
# restart. Off, we get recovery when it is actually needed and a DMA stream
# that otherwise stays locked to the frame.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=n

# --- NimBLE bond persistence ---
# IDF Kconfig help: "Enable this flag to make bonding persistent across
# device reboots." Arduino-prebuilt has it on; IDF default is n. Without
# it, every paired BLE peer (scale, HomeKit phone) re-pairs on every boot.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
