# Display-env sdkconfig overrides (layered on top of sdkconfig.common.defaults).
# Routes NimBLE host + WiFi/LWIP + BSS to PSRAM and keeps 16 KB internal
# reserved for DMA-bound callers. Avoids BLE_INIT malloc storms under the
# combined pressure of WiFi AP + HomeSpan + BLE GATT links on ESP32-S3.

# --- Flash size ---
# PlatformIO does NOT push board.json's flash size into the IDF build. All it
# does is compare the two after the fact and print a warning:
# builder/frameworks/espidf.py compares board upload.flash_size against
# CONFIG_ESPTOOLPY_FLASHSIZE and emits "Warning! Flash memory size mismatch
# detected." Nothing changes the config. Left unset, Kconfig's own default of
# 2 MB wins, the IDF-built bootloader records 2 MB in the image header, and IDF
# clamps usable flash to that -- which puts most of a default_16mb.csv layout
# (both OTA slots and the LittleFS partition) outside the addressable window.
#
# So it has to be pinned here, and this file is the display-class one: the
# LilyGo T-RGB is 16 MB. The 8 MB display-headless-8m board (seeed xiao) layers
# sdkconfig.flash8m.defaults after this file to override it, and the controller
# pins 8 MB in sdkconfig.controller.defaults. scripts/assert_sdkconfig.py checks
# the merged value against the board's declared size at link time so a new env
# cannot silently inherit the wrong one.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- PSRAM (octal 80MHz) - display-class boards only ---
#
# 80 MHz and not 120 MHz, deliberately. Octal PSRAM at 120 MHz would raise the
# documented pixel-clock ceiling for a PSRAM framebuffer from roughly 22 MHz to
# roughly 30 MHz, which would put 20 MHz and a 76 Hz refresh within reach. IDF
# gates it behind IDF_EXPERIMENTAL_FEATURES and states the failure mode: once
# the chip has powered on at some temperature, a swing of about 20 degrees C in
# either direction makes accesses to PSRAM crash randomly.
# SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR exists to re-tune from the
# on-chip sensor and would mitigate it, but this firmware runs an espresso
# machine with a boiler in the same enclosure, so a 20 degree swing is the
# normal duty cycle rather than an edge case, and the failure is a random crash
# rather than a visual glitch. 61 Hz with no artifacts is the better trade.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Threshold below which allocations are forced into internal DRAM. The
# arduino-esp32 baseline is 4096, and 512 was tried and reverted: it pushed
# mid-size allocations to PSRAM and left internal DRAM shattered into tiny
# blocks, taking startup fragmentation from 15% to 64% and starving the
# contiguous 2,872 B block AsyncTCP needs for every send round.
#
# 1024 is a different point on that curve and was measured, not assumed. Under
# the display-blestress rig with WiFi and BLE up, the animation running, and
# 8 KB of DMA-capable DRAM held hostage to stand in for a live controller link:
#
#                        DMA free   DMA min   largest block   failed allocs
#   4096 (baseline)         2,531       779           7,668               0
#   1024                    8,347     6,303           7,668               0
#
# The largest free block does not move, so the fragmentation that killed 512
# does not reproduce here. What the 5.8 KB buys is the bounce buffers going
# from ten scanlines to twelve, which is worth roughly half the remaining
# scan-out slips. Re-measure both columns before touching this again: the
# largest-block figure is the one that decides whether the web UI answers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384

# --- MSPI cache geometry ---
#
# Flash and PSRAM share one controller and one cache on the ESP32-S3, and the
# LCD scan-out has to win a race against everything else on that bus every
# frame. The cache line size sets how many bytes each miss fetches, so it is
# the direct lever on how many separate PSRAM transactions the same byte count
# costs. The framebuffer is streamed, not randomly poked: the render task
# writes it front to back and the bounce-buffer refill reads it front to back,
# which is the access pattern a long line serves best. At 32 bytes a 9600-byte
# bounce refill is 300 transactions; at 64 it is 150, each one amortising the
# octal-PSRAM command and latency overhead over twice as much payload.
#
# This costs no RAM: the cache is already allocated, only its line granularity
# changes. There is no matching knob for instructions -- the S3's instruction
# cache tops out at a 32-byte line.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Not raising the optimization level to PERF (-O2) either, though Espressif
# lists that alongside the cache-line setting as a bounce-buffer prerequisite.
# Measured both ways on this board at 16 MHz:
#
#   -O2 costs 2.2% mean frame rate across all thirteen background animations,
#   slower on ten of the thirteen, worst on nebula (-6.9%) and starfield
#   (-6.3%). Image size actually fell by 32 kB, so this is not icache pressure
#   from bigger code; there is simply nothing left for the compiler to find. The
#   hot loops here are hand-written Xtensa PIE assembly and the rest of the
#   frame is memory-bound.
#
#   It also buys no scan-out headroom, which was the reason to try it. At a
#   divider of 4 (20 MHz, 76 Hz) the panel still shows band-local tearing in
#   roughly a quarter of captured frames, the same as under -Os. 16 MHz remains
#   the ceiling.
#
# So the whole-project -Os from sdkconfig.common.defaults stands.

# Not enabling CONFIG_SPIRAM_XIP_FROM_PSRAM (and so not
# SPIRAM_FETCH_INSTRUCTIONS / SPIRAM_RODATA), even though Espressif's LCD FAQ
# lists them among the prerequisites for RGB bounce-buffer mode. Their argument
# is sound on both counts: flash and PSRAM share the MSPI controller and octal
# PSRAM is four times the bandwidth of quad SDR flash, so an instruction miss
# served from PSRAM occupies the controller for a quarter as long; and a flash
# write disables the cache, which suspends the bounce-buffer refill ISR
# (esp_lcd_panel_rgb.c warns its memcpy would crash, not merely glitch, if it
# ran then), so every NVS save is a run of stale bounce buffers on screen.
#
# It does not survive contact with this firmware's size. Measured: copying .text
# and .rodata into PSRAM at startup took 4.3 MB of the 4.5 MB free, leaving
# 255 kB. Internal DRAM gained 19.5 kB, since code that needed IRAM placement no
# longer does, but the background animations could not allocate their working
# buffers at all and the screen came up as bare text on black. The embedded web
# UI blob and the LVGL fonts are most of that 4.3 MB.
#
# So the brief corruption during an NVS write stands as a known defect. It is
# bounded by the write and it is what upstream ships.

# Route NimBLE host + mbedTLS allocations to PSRAM (reclaims ~40 KB internal).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 4 connections: display acts as central for BLE scales + peripheral for HomeKit.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# Bump host task stack from 4096: continuous scale scanning drives the NimBLE
# host callback context hot. 4 KB runs close to the high-water mark during
# scan-complete bursts.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# HKDF used by HomeSpan for HomeKit pairing key derivation.
CONFIG_MBEDTLS_HKDF_C=y

# --- LWIP (socket tuning borrowed from ESPHome PR #10647) ---
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y

# Two segments in flight per connection, not four. This is a memory setting
# wearing a throughput costume.
#
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP puts lwIP's pbufs in PSRAM, and the WiFi MAC
# cannot DMA out of PSRAM, so every outgoing segment is first copied into an
# internal DMA-capable "cache TX" buffer of about 1630 bytes. Those come out of
# the same ~12 kB DMA-capable pool the radios and the LCD bounce buffers live
# in. At the 5760-byte default each connection can have four segments in
# flight, so two connections are enough to claim the whole pool.
#
# Measured on the shipping build, browser-shaped load over the real 105 kB of
# web UI assets (61 kB JS, 29 kB CSS, 12.9 kB PNG):
#   1 connection:   28/28 requests ok
#   4 connections:  61/84 ok, 23 timed out
#   8 connections:  71/168 ok
#   16 connections: 27/224 ok
# with 547 failed allocations, 522 of them the 1630-byte cache TX buffer, and
# DMA-capable free driven from 12.3 kB down to a 247-byte low-water mark. The
# collateral damage reached past the web server: UDP sends returned ENOMEM, DNS
# lookups failed, and the STA reported ESP_ERR_WIFI_STATE. A browser opens six
# parallel connections, which is exactly the failing case.
#
# 2880 costs nothing that matters here. On a LAN at a few ms RTT it still
# permits roughly half a megabyte per second per connection, and the largest
# asset is 61 kB.
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
# 2880 is the floor, not a choice. lwIP requires the send buffer to hold at
# least two maximum segments, so 1440 (one segment) is rejected and the value
# silently falls all the way back to the 5760 default. The build guard catches
# it; do not "optimise" this downwards.

# --- Admission control does not help: measured ---
# Capping active PCBs at 10 with TCP_MSL cut to 5 s, on the theory that fewer
# connections each getting enough memory beats a dozen starving together, made
# no difference: the two-tab cold load still timed out on every asset, and the
# websockets stopped receiving as well. The shortage is DMA-capable bytes, and
# WiFi TX demand scales with in-flight data rather than with connection count,
# so bounding the connection count does not bound the demand. Left at defaults.

# --- WiFi TX buffers: dynamic is not reachable from here ---
# WiFi holds 16 static TX buffers of about 1.6 kB each, ~25.6 kB of DMA-capable
# internal DRAM, whatever the traffic looks like, and when that pool is
# exhausted it falls back to malloc'ing 1630-byte cache TX buffers. Those are
# the allocations that fail here under load. Dynamic TX buffers would size
# themselves to the actual frame and free the fixed pool, but esp_wifi's
# Kconfig gates them behind
#   !(SPIRAM_TRY_ALLOCATE_WIFI_LWIP && !SPIRAM_IGNORE_NOTFOUND)
# and SPIRAM_IGNORE_NOTFOUND in turn depends on !SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY,
# which this build relies on to keep BSS out of internal DRAM. Enabling it also
# makes WiFi and lwIP behave as if there were no PSRAM at all, which is the
# opposite of what the rest of this file is doing. The build guard caught the
# attempt: none of the three symbols reached the merged config.

# --- WiFi static TX buffer pool ---
# TX is forced 100% static here: ESP_WIFI_DYNAMIC_TX_BUFFER depends on
# !(SPIRAM_TRY_ALLOCATE_WIFI_LWIP && !SPIRAM_IGNORE_NOTFOUND), and this build
# needs the first and cannot have the second. So the driver reserves
# STATIC_TX_BUFFER_NUM buffers of ~1.6 kB at esp_wifi_init and holds them for
# the process lifetime, traffic or no traffic: 16 of them is ~26 kB of the
# DMA-capable pool, permanently.
# This is structurally unlike the RX pool below. RX runs static AND dynamic
# concurrently, so shrinking static just moves the load onto the dynamic pool
# out of the same heap, which is why that experiment went backwards. TX has no
# concurrent fallback; what it does have is CACHE_TX_BUFFER_NUM (32), an
# overflow queue that engages once the static pool is exhausted. Shrinking the
# static reservation therefore converts permanently-parked memory into elastic
# on-demand memory the driver already knows how to use.
# Measured: 16 -> 10 went backwards on both counts. Steady-state dma free fell
# 12,335 -> 10,575, and the two-tab browser load got worse rather than better,
# failing on index.html itself where 16 at least served it. Whatever the static
# pool costs, releasing part of it does not land in the pool the TX path draws
# from. Left at the default, like RX below.
#CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
#
# Turning SPIRAM_TRY_ALLOCATE_WIFI_LWIP off was the other way at this: it makes
# ESP_WIFI_DYNAMIC_TX_BUFFER selectable and default, which would retire the
# 1630-byte cache TX buffer class outright instead of competing for it. It also
# moves WiFi's and lwIP's own structures into internal DRAM, and that bill is
# far larger than the one it settles: steady-state dma free 12,335 -> 3,027,
# min 1,587. Under the two-tab load the websocket could not connect at all and
# status polls started failing. Confirmed reject; keep lwIP in PSRAM.

# --- Beacon receive path in IRAM: measured, no effect on scan-out ---
# ESP_WIFI_SLP_IRAM_OPT looks like it should matter here and does not.
# esp_wifi's Kconfig gives it one default, "default y if SOC_WIFI_HE_SUPPORT",
# and the ESP32-S3 has no HE support (the symbol is absent from
# esp32s3/soc_caps.h), so it silently defaults to n on this chip. Its help text
# names what therefore stays in flash: "Wi-Fi library TBTT process and receive
# beacon functions". TBTT is the DTIM wake, the station runs WIFI_PS_MIN_MODEM,
# and so it executes from flash roughly every 100 ms while associated, on the
# MSPI controller the LCD bounce refill reads the framebuffer through. A clean
# periodic jitter source, on paper.
# Measured at 8 bounce lines over a 720 s idle window: 7 slips / 31,284 frames,
# against 6.7 expected from the rate without it. No effect. It also costs
# ~2.3 kB of the DMA-capable pool (dma free 18,299 -> 15,979), which is enough
# to put the two-tab browser load back into timing out. Rejected on both counts.

# --- WiFi RX buffer depth: measured, and it goes the wrong way ---
# Arduino defaults to 16 static and 32 dynamic RX buffers, and the static ones
# look like an easy ~13 kB of DMA-capable internal DRAM to reclaim. Halving
# both (8/16) instead COST memory: steady-state dma free fell 12,335 -> 10,567
# and internal free 20,111 -> 18,343. Shrinking the static pool just pushes the
# driver into allocating dynamic RX buffers from the same heap, which is worse
# than the fixed pool it replaced. Left at the Arduino defaults deliberately.

# --- IPv6 ---
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# --- Nano newlib ---
# Disabled: HomeSpan 2.1.7 uses GNU %m scanf in Span::configureNetwork() —
# nano-newlib drops it, leaving `d` uninitialised and crashing on strlen(d).
# Full newlib costs ~15-25 KB flash.
# NOTE: IDF 5.5 renamed NEWLIB_NANO_FORMAT → LIBC_NEWLIB_NANO_FORMAT.
CONFIG_LIBC_NEWLIB_NANO_FORMAT=n

# --- C++ exceptions ---
# esp-arduino-ble-scales' RemoteScales uses try/catch (e.g. the noexcept dtor
# wraps clientCleanup()). IDF defaults to -fno-exceptions; arduino-esp32 built
# with exceptions on, so the display class enables them here. Controller env
# does not link the scales lib and stays -fno-exceptions.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# --- RGB LCD: restart GDMA at every VBlank ---
# Off, which is also the IDF default. It was on as a workaround for the
# scan-out desync that GM_LCD_BOUNCE_LINES now fixes at the source, and in
# bounce mode it does active harm.
#
# Read lcd_rgb_panel_try_restart_transmission() in
# components/esp_lcd/rgb/esp_lcd_panel_rgb.c. With this set, do_restart is
# true unconditionally, so the LCD FIFO and the GDMA channel are reset on
# every VSYNC. Without bounce buffers that restarts the stream from the
# framebuffer head, which is where the old comment here got its claim. With
# bounce buffers it restarts from bounce_buffer[0], filled from whatever
# bounce_pos_px the refill ISR had reached, and that pointer is only forced
# back to 0 when it exceeds two buffers. So each frame begins scanning at a
# near-arbitrary multiple of the bounce buffer and the picture jumps
# vertically in 5-line steps, frame after frame. Observed on hardware as a
# pronounced vertical shake.
#
# It also compiles out the genuine underrun detector, which lives only in
# the #else branch: bb_eof_count < expect_eof_count at VSYNC means the
# refill ISR fell behind during the frame, and that is what should trigger a
# restart. Off, we get recovery when it is actually needed and a DMA stream
# that otherwise stays locked to the frame.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=n

# --- NimBLE bond persistence ---
# IDF Kconfig help: "Enable this flag to make bonding persistent across
# device reboots." Arduino-prebuilt has it on; IDF default is n. Without
# it, every paired BLE peer (scale, HomeKit phone) re-pairs on every boot.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# --- BLE controller code placement ---
# sdkconfig.common.defaults sets CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y. Leave it
# there. Moving the controller to IRAM is tempting, because flash and PSRAM
# share one MSPI controller on the ESP32-S3 and every controller instruction
# fetch that misses icache competes with the LCD bounce refill. It is not
# affordable: the IRAM grows .dram0.dummy and takes ~12 kB straight out of the
# DMA-capable heap. Measured with the linktest rig holding a live BLE link:
#   flash controller, 12 bounce lines: dma free 12351 / min 6528, 0 failed
#   IRAM  controller, 12 bounce lines: dma free   552 / min  180, 273 failed
#   IRAM  controller,  8 bounce lines: dma free  8136 / min 7476, 1 failed
# The last row looks survivable and is not. In both IRAM builds WiFi lands in
# the failure this whole fix exists to prevent: ICMP still replies while every
# TCP connect is dropped, because lwIP cannot allocate a PCB. Dropping to 8
# bounce lines to pay for it also costs more tearing than it buys.

# --- BLE controller sizing ---
# The controller keeps per-activity and per-connection state in internal DRAM,
# and esp_bt_controller_enable() costs 44.3 KB of it on this board -- measured,
# and second only to WiFi. BLE_MAX_ACT covers connections plus scanning and
# advertising slots; this display talks to one controller board and at most one
# scale, so 6 activities and 4 host connections were sized for a device that
# does not exist. The duplicate-scan cache is 100 entries of continuously
# scanned advertisers, which is generous for a fixed-function appliance.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=20

# --- Instruction cache geometry: nothing to win here ---
# The BLE controller executes from flash, so its icache misses are MSPI
# transactions competing with the bounce refill's PSRAM reads. Two obvious
# responses both fail on the ESP32-S3:
#   - Wider lines. The dcache runs 64-byte lines, but esp_system's
#     Kconfig.cache offers the icache only 16 or 32 bytes, and 16 only at the
#     16 kB size. 32 is already the maximum and already set.
#   - A bigger icache. 16 kB -> 32 kB comes straight out of SRAM, and there is
#     roughly 15 kB of internal free at steady state. Paying for it by halving
#     the dcache is worse than the disease: the dcache is what the refill
#     reads the framebuffer through.
