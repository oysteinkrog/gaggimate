# Build output — regenerate with `make` (see Makefile).
build/

# Device assembly — regenerate with `./xtensa-asm.sh all`. Text, but it churns
# on every optimization and carries no information the source doesn't.
xtensa-asm/

# golden/ IS tracked on purpose: it is the fidelity baseline every optimization
# is diffed against, and the whole set packs to ~1.3 MB. To rebuild it from the
# pre-optimization code:
#   git checkout 834b0338^ -- src/display/ui/default/bganim
#   make && ./build/bench --golden golden
#   git checkout HEAD -- src/display/ui/default/bganim
