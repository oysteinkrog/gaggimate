# Theme publication check (gm-bzu.71): palette builds under concurrent theme
# publishes. See theme_gen_check.cpp.
#
#   make -f Makefile.theme check      build and run
BIN ?= build/theme_gen_check
ANIM_DIR := ../../src/display/ui/default/bganim
SRCS := theme_gen_check.cpp mathcount.cpp $(wildcard $(ANIM_DIR)/*.cpp)
CXXFLAGS := -O2 -g -std=gnu++17 -pthread -Ishim -I. -I$(ANIM_DIR) -include mathcount.h -Wall -Wno-unused-function

$(BIN): $(SRCS) mathcount.h shim/Arduino.h shim/esp_heap_caps.h shim/esp_memory_utils.h
	@mkdir -p $(dir $(BIN))
	g++ $(CXXFLAGS) $(SRCS) -o $(BIN) -lm

check: $(BIN)
	./$(BIN)

clean:
	rm -f $(BIN)
.PHONY: check clean
